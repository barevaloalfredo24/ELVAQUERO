# =====================================================================
# VARIABLES DE ENTORNO DEL BACKEND
# ---------------------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores según tu entorno.
# NUNCA subas el archivo .env (con secretos) al repositorio.
# =====================================================================

# Cadena de conexión a PostgreSQL (docker-compose local por defecto).
DATABASE_URL="postgresql://elvaquero:elvaquero@localhost:5432/elvaquero?schema=public"

# Secreto para firmar los tokens JWT de autenticación.
JWT_SECRET="cambia-este-secreto-en-produccion"

# Puerto en el que escucha el backend.
PORT=4000

# Clave de Stripe (fase de pagos; opcional por ahora).
STRIPE_SECRET_KEY=""

# Credenciales de Cloudinary (subida de imágenes de productos).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Client ID de Google OAuth (login con Google).
GOOGLE_CLIENT_ID=""

# Resend (envío de correos transaccionales, p. ej. recuperación de contraseña).
RESEND_API_KEY=""
EMAIL_FROM="El Vaquero <onboarding@resend.dev>"
