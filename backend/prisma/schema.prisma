generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alertas_stock {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variante_id        String              @db.Uuid
  umbral_al_disparar Int
  stock_al_disparar  Int
  estado             estado_alerta_stock @default(abierta)
  fecha_notificacion DateTime            @default(now()) @db.Timestamptz(6)
  fecha_resolucion   DateTime?           @db.Timestamptz(6)
  variantes_producto variantes_producto  @relation(fields: [variante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([estado], map: "idx_alertas_stock_estado")
  @@index([variante_id], map: "idx_alertas_stock_variante")
}

model carritos {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String?         @db.Uuid
  id_sesion           String?         @db.VarChar(255)
  fecha_creacion      DateTime        @default(now()) @db.Timestamptz(6)
  fecha_actualizacion DateTime        @default(now()) @db.Timestamptz(6)
  usuarios            usuarios?       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items_carrito       items_carrito[]

  @@index([id_sesion], map: "idx_carritos_sesion")
  @@index([usuario_id], map: "idx_carritos_usuario")
}

model categorias {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String       @db.VarChar(100)
  slug               String       @unique @db.VarChar(120)
  categoria_padre_id String?      @db.Uuid
  imagen             String?      @db.VarChar(500)
  alt                String?      @db.VarChar(255)
  fecha_creacion     DateTime     @default(now()) @db.Timestamptz(6)
  categorias         categorias?  @relation("categoriasTocategorias", fields: [categoria_padre_id], references: [id], onUpdate: NoAction)
  other_categorias   categorias[] @relation("categoriasTocategorias")
  productos          productos[]

  @@index([categoria_padre_id], map: "idx_categorias_padre")
}

model cuentas_oauth {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id           String          @db.Uuid
  proveedor            proveedor_oauth
  id_proveedor_usuario String          @db.VarChar(255)
  fecha_creacion       DateTime        @default(now()) @db.Timestamptz(6)
  usuarios             usuarios        @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([proveedor, id_proveedor_usuario])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cupones {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo               String              @unique @db.VarChar(50)
  tipo_descuento       tipo_descuento
  valor_descuento      Decimal             @db.Decimal(12, 2)
  monto_minimo_orden   Decimal?            @default(0) @db.Decimal(12, 2)
  limite_uso           Int?
  veces_usado          Int                 @default(0)
  fecha_inicio_validez DateTime            @db.Timestamptz(6)
  fecha_fin_validez    DateTime            @db.Timestamptz(6)
  esta_activo          Boolean             @default(true)
  fecha_creacion       DateTime            @default(now()) @db.Timestamptz(6)
  ordenes              ordenes[]
  redenciones_cupon    redenciones_cupon[]
}

model direcciones {
  id                                                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id                                            String    @db.Uuid
  alias                                                 String?   @db.VarChar(50)
  calle                                                 String    @db.VarChar(255)
  ciudad                                                String    @db.VarChar(100)
  provincia                                             String?   @db.VarChar(100)
  codigo_postal                                         String?   @db.VarChar(20)
  pais                                                  String    @db.VarChar(100)
  es_predeterminada                                     Boolean   @default(false)
  fecha_creacion                                        DateTime  @default(now()) @db.Timestamptz(6)
  usuarios                                              usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ordenes_ordenes_direccion_envio_idTodirecciones       ordenes[] @relation("ordenes_direccion_envio_idTodirecciones")
  ordenes_ordenes_direccion_facturacion_idTodirecciones ordenes[] @relation("ordenes_direccion_facturacion_idTodirecciones")

  @@index([usuario_id], map: "idx_direcciones_usuario")
}

model historial_estados_orden {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id       String       @db.Uuid
  estado         estado_orden
  modificado_por String?      @db.Uuid
  fecha_cambio   DateTime     @default(now()) @db.Timestamptz(6)
  nota           String?
  usuarios       usuarios?    @relation(fields: [modificado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordenes        ordenes      @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orden_id], map: "idx_historial_estados_orden")
}

model imagenes_producto {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id       String    @db.Uuid
  url               String    @db.VarChar(500)
  texto_alternativo String?   @db.VarChar(255)
  posicion          Int       @default(0) @db.SmallInt
  fecha_creacion    DateTime  @default(now()) @db.Timestamptz(6)
  productos         productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([producto_id], map: "idx_imagenes_producto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model items_carrito {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carrito_id         String             @db.Uuid
  variante_id        String             @db.Uuid
  cantidad           Int
  precio_unitario    Decimal            @db.Decimal(12, 2)
  fecha_agregado     DateTime           @default(now()) @db.Timestamptz(6)
  carritos           carritos           @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variantes_producto variantes_producto @relation(fields: [variante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([carrito_id, variante_id])
  @@index([carrito_id], map: "idx_items_carrito_carrito")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model items_orden {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id                 String             @db.Uuid
  variante_id              String             @db.Uuid
  nombre_producto_snapshot String             @db.VarChar(200)
  sku_snapshot             String             @db.VarChar(100)
  precio_unitario          Decimal            @db.Decimal(12, 2)
  cantidad                 Int
  subtotal                 Decimal            @db.Decimal(12, 2)
  ordenes                  ordenes            @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variantes_producto       variantes_producto @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orden_id], map: "idx_items_orden_orden")
  @@index([variante_id], map: "idx_items_orden_variante")
}

model listas_deseos {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String    @db.Uuid
  producto_id    String    @db.Uuid
  fecha_agregado DateTime  @default(now()) @db.Timestamptz(6)
  productos      productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, producto_id])
  @@index([usuario_id], map: "idx_listas_deseos_usuario")
}

model notificaciones_admin {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                   tipo_notificacion
  mensaje                String
  id_entidad_relacionada String?           @db.Uuid
  esta_leida             Boolean           @default(false)
  fecha_creacion         DateTime          @default(now()) @db.Timestamptz(6)

  @@index([esta_leida], map: "idx_notificaciones_leida")
  @@index([tipo], map: "idx_notificaciones_tipo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ordenes {
  id                                                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero_orden                                              String                    @unique @db.VarChar(30)
  usuario_id                                                String                    @db.Uuid
  estado                                                    estado_orden              @default(pendiente)
  metodo_pago                                               tipo_metodo_pago
  direccion_envio_id                                        String?                   @db.Uuid
  direccion_facturacion_id                                  String?                   @db.Uuid
  cupon_id                                                  String?                   @db.Uuid
  subtotal                                                  Decimal                   @db.Decimal(12, 2)
  descuento_total                                           Decimal                   @default(0) @db.Decimal(12, 2)
  envio_total                                               Decimal                   @default(0) @db.Decimal(12, 2)
  impuestos_total                                           Decimal                   @default(0) @db.Decimal(12, 2)
  total                                                     Decimal                   @db.Decimal(12, 2)
  moneda                                                    String                    @default("GTQ") @db.Char(3)
  fecha_creacion                                            DateTime                  @default(now()) @db.Timestamptz(6)
  fecha_actualizacion                                       DateTime                  @default(now()) @db.Timestamptz(6)
  numero_seguimiento                                        String?                   @db.VarChar(100)
  paqueteria                                                String?                   @db.VarChar(100)
  historial_estados_orden                                   historial_estados_orden[]
  items_orden                                               items_orden[]
  cupones                                                   cupones?                  @relation(fields: [cupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  direcciones_ordenes_direccion_envio_idTodirecciones       direcciones?              @relation("ordenes_direccion_envio_idTodirecciones", fields: [direccion_envio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  direcciones_ordenes_direccion_facturacion_idTodirecciones direcciones?              @relation("ordenes_direccion_facturacion_idTodirecciones", fields: [direccion_facturacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios                                                  usuarios                  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pagos                                                     pagos[]
  redenciones_cupon                                         redenciones_cupon[]

  @@index([estado], map: "idx_ordenes_estado")
  @@index([fecha_creacion], map: "idx_ordenes_fecha")
  @@index([usuario_id], map: "idx_ordenes_usuario")
}

model pagos {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id               String           @db.Uuid
  metodo                 tipo_metodo_pago
  estado                 estado_pago      @default(pendiente)
  id_intento_pago_stripe String?          @db.VarChar(255)
  monto                  Decimal          @db.Decimal(12, 2)
  moneda                 String           @default("GTQ") @db.Char(3)
  fecha_pago             DateTime?        @db.Timestamptz(6)
  fecha_creacion         DateTime         @default(now()) @db.Timestamptz(6)
  ordenes                ordenes          @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orden_id], map: "idx_pagos_orden")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model productos {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria_id        String?              @db.Uuid
  nombre              String               @db.VarChar(200)
  slug                String               @unique @db.VarChar(220)
  descripcion         String?
  precio_base         Decimal              @db.Decimal(12, 2)
  esta_activo         Boolean              @default(true)
  fecha_creacion      DateTime             @default(now()) @db.Timestamptz(6)
  fecha_actualizacion DateTime             @default(now()) @db.Timestamptz(6)
  imagenes_producto   imagenes_producto[]
  listas_deseos       listas_deseos[]
  categorias          categorias?          @relation(fields: [categoria_id], references: [id], onUpdate: NoAction)
  resenas             resenas[]
  variantes_producto  variantes_producto[]
  vistas_producto     vistas_producto[]

  @@index([esta_activo], map: "idx_productos_activo")
  @@index([categoria_id], map: "idx_productos_categoria")
  @@index([nombre(ops: raw("gin_trgm_ops"))], map: "idx_productos_nombre_trgm", type: Gin)
}

model redenciones_cupon {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupon_id        String   @db.Uuid
  usuario_id      String   @db.Uuid
  orden_id        String   @db.Uuid
  fecha_redencion DateTime @default(now()) @db.Timestamptz(6)
  cupones         cupones  @relation(fields: [cupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ordenes         ordenes  @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios        usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cupon_id], map: "idx_redenciones_cupon")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resenas {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id    String    @db.Uuid
  usuario_id     String    @db.Uuid
  calificacion   Int       @db.SmallInt
  comentario     String?
  esta_aprobada  Boolean   @default(false)
  fecha_creacion DateTime  @default(now()) @db.Timestamptz(6)
  productos      productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([producto_id, usuario_id])
  @@index([producto_id], map: "idx_resenas_producto")
}

model usuarios {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_completo         String                    @db.VarChar(150)
  correo                  String                    @unique @db.VarChar(150)
  contrasena_hash         String?                   @db.VarChar(255)
  telefono                String?                   @db.VarChar(30)
  rol                     rol_usuario               @default(cliente)
  correo_verificado       Boolean                   @default(false)
  esta_activo             Boolean                   @default(true)
  fecha_creacion          DateTime                  @default(now()) @db.Timestamptz(6)
  fecha_actualizacion     DateTime                  @default(now()) @db.Timestamptz(6)
  carritos                carritos[]
  cuentas_oauth           cuentas_oauth[]
  direcciones             direcciones[]
  historial_estados_orden historial_estados_orden[]
  listas_deseos           listas_deseos[]
  ordenes                 ordenes[]
  redenciones_cupon       redenciones_cupon[]
  resenas                 resenas[]
  verificaciones_correo   verificaciones_correo[]
  vistas_producto         vistas_producto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model variantes_producto {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id         String          @db.Uuid
  sku                 String          @unique @db.VarChar(100)
  atributos           Json            @default("{}")
  precio_alternativo  Decimal?        @db.Decimal(12, 2)
  cantidad_stock      Int             @default(0)
  umbral_stock_bajo   Int             @default(5)
  esta_activo         Boolean         @default(true)
  fecha_creacion      DateTime        @default(now()) @db.Timestamptz(6)
  fecha_actualizacion DateTime        @default(now()) @db.Timestamptz(6)
  alertas_stock       alertas_stock[]
  items_carrito       items_carrito[]
  items_orden         items_orden[]
  productos           productos       @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([producto_id], map: "idx_variantes_producto")
  @@index([cantidad_stock], map: "idx_variantes_stock")
}

model verificaciones_correo {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String    @db.Uuid
  token              String    @unique @db.VarChar(255)
  fecha_expiracion   DateTime  @db.Timestamptz(6)
  fecha_verificacion DateTime? @db.Timestamptz(6)
  fecha_creacion     DateTime  @default(now()) @db.Timestamptz(6)
  usuarios           usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_verificaciones_usuario")
}

model vistas_producto {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String?   @db.Uuid
  id_sesion   String?   @db.VarChar(255)
  producto_id String    @db.Uuid
  fecha_vista DateTime  @default(now()) @db.Timestamptz(6)
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios    usuarios? @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([fecha_vista], map: "idx_vistas_producto_fecha")
  @@index([producto_id], map: "idx_vistas_producto_producto")
  @@index([usuario_id], map: "idx_vistas_producto_usuario")
}

enum estado_alerta_stock {
  abierta
  resuelta
}

enum estado_orden {
  pendiente
  pagado
  procesando
  enviado
  entregado
  cancelado
  reembolsado
}

enum estado_pago {
  pendiente
  exitoso
  fallido
  reembolsado
}

enum proveedor_oauth {
  google
}

enum rol_usuario {
  cliente
  admin
  staff
}

enum tipo_descuento {
  porcentaje
  fijo
}

enum tipo_metodo_pago {
  tarjeta
  contra_entrega
}

enum tipo_notificacion {
  stock_bajo
  nueva_orden
  pago_fallido
  nueva_resena
}
